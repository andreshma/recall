# Local environment: recreate with `uv venv` + `uv pip sync requirements.lock`.
.venv/
__pycache__/
*.pyc
.pytest_cache/
# The index and state live in %LOCALAPPDATA%\recall, never in the repo; in case
# someone points RECALL_HOME here by mistake:
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.log
service.json
.coverage
.coverage.*
htmlcov/
# Local map of book id -> PDF path for tools/build_pages.py (never published).
data/*.local.json
